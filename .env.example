# AI-Rabotnik self-host — пример переменных окружения (скопируй в .env, заполни секреты)
# НЕ коммить .env в репозиторий (уже в .gitignore)

# Сайт
PORT=8080

# n8n basic-auth (обязательно сменить на проде!)
N8N_USER=admin
N8N_PASSWORD=change-me
WEBHOOK_URL=http://localhost:5678

# Postgres / БД
POSTGRES_USER=airabotnik
POSTGRES_PASSWORD=aistrongpass
POSTGRES_DB=airabotnik

# Lead API поднимет миграцию сам (SQLAlchemy create_all) при старте.
# DATABASE_URL переопределять не нужно — compose сам собирает из POSTGRES_*.
